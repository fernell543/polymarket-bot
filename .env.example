# Your Polygon wallet private key (no 0x prefix needed)
PRIVATE_KEY=your_private_key_here

# Your wallet address (checksummed)
WALLET_ADDRESS=0xYourWalletAddressHere

# Polymarket CLOB API host
CLOB_HOST=https://clob.polymarket.com

# Polygon RPC (default: public endpoint)
POLYGON_RPC=https://polygon-rpc.com

# Strategy parameters
MAX_POSITION_USDC=500        # Max USDC per position
ARB_MIN_PROFIT_PCT=0.03      # Min 3% profit for arbitrage
MARKET_MAKER_SPREAD=0.02     # 2% spread for market making
MM_ORDER_SIZE_USDC=100       # USDC per MM order per side

# Dry run mode: 1 = simulate only, 0 = real trades
DRY_RUN=1
