# =============================================================================
# Polymarket Bot — Environment Configuration Template
# =============================================================================
# Copy to .env and fill in your values.  .env is git-ignored.
# Lines starting with # are comments.  All values shown are the code defaults.
#
# Sections:
#   1. REQUIRED — bot will refuse to start in live mode without these
#   2. API / Network
#   3. Position Sizing  (always active)
#   4. Market Making
#   5. Latency Arb
#   6. Safety & Thresholds
#   7. Quant Mode  (disabled by default — safe for paper)
#      7a. Signal Engine
#      7b. Risk Engine
#      7c. Execution Layer
#      7d. Param Profiles & Kill-Switch
# =============================================================================


# =============================================================================
# 1. REQUIRED (live trading only — not validated in DRY_RUN=1 mode)
# =============================================================================

PRIVATE_KEY=
WALLET_ADDRESS=

# Polymarket "funder" proxy address — the wallet that holds your positions on-chain.
# In a standard Polymarket web-UI account this is NOT the same as your signing key.
# Find it in your Polymarket account settings or via the CLOB API.
# Accepts POLY_FUNDER or FUNDER (legacy compat); defaults to WALLET_ADDRESS if omitted.
POLY_FUNDER=

# Signing mode — 2 is proven to work with standard Polymarket web accounts.
# 0 = EOA direct, 1 = Gnosis-safe, 2 = API-key derived from proxy/funder (default).
POLY_SIGNATURE_TYPE=2


# =============================================================================
# 2. API / Network
# =============================================================================

# CLOB_HOST and POLYMARKET_HOST are accepted interchangeably.
CLOB_HOST=https://clob.polymarket.com
POLYGON_RPC=https://polygon-rpc.com


# =============================================================================
# 3. Position Sizing  (risk/sizing.py — always active, no quant flag needed)
# =============================================================================

# Fraction of account balance risked per directional trade (PriceArb / LatencyArb).
# 0.02 = 2 %.  Safe paper default; raise cautiously for live.
RISK_BUDGET_PCT=0.02

# Absolute floor / ceiling applied after all multipliers (USDC).
SIZE_MIN_USDC=5.0
SIZE_MAX_USDC=500.0

# Volatility-regime multipliers.
#   low  = calm/ranging market  → slight size increase
#   mid  = neutral baseline
#   high = trending/volatile    → size reduction
VOL_MULT_LOW=1.2
VOL_MULT_MID=1.0
VOL_MULT_HIGH=0.6

# Guard: confidence below this → size=0 (trade skipped).
CONFIDENCE_FLOOR=0.20

# Guard: net edge below this (basis points) → size=0.
# 50 bps = 0.5 %.  Should exceed fees + slippage.
EDGE_FLOOR_BPS=50.0

# Normalisation point: edge at this BPS → edge_scalar=1.0.
# Edge above → scalar up to 2×; below (but above floor) → scalar <1.
EDGE_REFERENCE_BPS=100.0


# =============================================================================
# 4. Market Making
# =============================================================================

# Target bid-ask half-spread as a fraction (0.02 = 2 % each side).
MARKET_MAKER_SPREAD=0.02

# Fraction of balance deployed across all MM orders combined.
MM_CAPITAL_PCT=0.20

# Notional balance assumed when real balance is unavailable (paper/startup).
MM_STARTING_BALANCE=5000

# How many top-reward markets to target simultaneously.
MM_TARGET_MARKETS=5

# Interval between quote refreshes (seconds).
# MM_REBALANCE_INTERVAL=30   # hard-coded; not currently env-overridable


# =============================================================================
# 5. Latency Arb
# =============================================================================

# Enter position if this many seconds remain before market resolution.
# LATENCY_ARB_WINDOW_SECS=60   # hard-coded default

# Minimum price discount vs fair value required to enter.
# LATENCY_ARB_MIN_DISCOUNT=0.05  # hard-coded default


# =============================================================================
# 6. Safety & Thresholds
# =============================================================================

# DRY_RUN=1 → simulate orders (log only, no real CLOB calls).
# DRY_RUN=0 → live trading.  REQUIRES PRIVATE_KEY + WALLET_ADDRESS.
DRY_RUN=1

# Minimum percentage profit required for a price-arb trade.
ARB_MIN_PROFIT_PCT=0.03

# Hard cap: maximum USDC in a single open position (all strategies).
MAX_POSITION_USDC=500

# Minimum number of active markets required for the bot to trade.
# If the API returns fewer, the bot enters safe mode.
MIN_MARKETS_THRESHOLD=10


# =============================================================================
# 7. Quant Mode  (master switch — default OFF)
# =============================================================================
# Set QUANT_MODE_ENABLED=1 to activate signal engine, vol-targeting,
# adaptive execution, daily-loss / drawdown circuit breakers.
# Safe to leave at 0 for basic paper runs.

QUANT_MODE_ENABLED=0


# -----------------------------------------------------------------------------
# 7a. Signal Engine  (QUANT_MODE_ENABLED=1 required)
# -----------------------------------------------------------------------------

# Factor weights — applied relative to each other in the composite formula.
SIGNAL_WEIGHT_MICRO=0.30
SIGNAL_WEIGHT_MOMENTUM=0.35
SIGNAL_WEIGHT_MEAN_REV=0.35

# Minimum signal confidence [0..1] to open a new position.
# Lower = more trades, lower average quality.  Start conservative (0.40+).
SIGNAL_CONFIDENCE_THRESHOLD=0.40

# Rolling price std/mean above this ratio → "trending" regime (momentum-dominant).
# Below → "ranging" (mean-reversion-dominant).
REGIME_HIGH_VOL_THRESHOLD=0.02


# -----------------------------------------------------------------------------
# 7b. Risk Engine  (QUANT_MODE_ENABLED=1 required)
# -----------------------------------------------------------------------------

# Target annualised-ish volatility for vol-targeting (fraction of notional).
# 0.05 = 5 % daily vol target.  Lower = smaller positions in volatile markets.
RISK_TARGET_VOL=0.05

# Maximum USDC deployed in any single market at one time.
RISK_MAX_MARKET_EXPOSURE=200.0

# Maximum total USDC deployed across the entire portfolio.
RISK_MAX_PORTFOLIO_EXPOSURE=1000.0

# Hard stop: no new trades when daily realised P&L falls below -LIMIT USDC.
# Resets at midnight UTC.
RISK_DAILY_LOSS_LIMIT=100.0

# Hard stop: no new trades when session drawdown exceeds this USDC.
# Does NOT auto-reset — requires manual restart.
RISK_MAX_DRAWDOWN=200.0

# Consecutive-loss cooldown trigger and duration.
RISK_MAX_CONSECUTIVE_LOSSES=3
RISK_COOLDOWN_SECS=300


# -----------------------------------------------------------------------------
# 7c. Execution Layer  (QUANT_MODE_ENABLED=1 required)
# -----------------------------------------------------------------------------

# Minimum net edge (after fee + slippage) required to place an order.
# 0.010 = 1 %.  Raise to be more selective.
EXEC_MIN_EDGE=0.010

# Signal confidence >= this → prefer market (taker) order for faster fill.
EXEC_TAKER_CONFIDENCE_THRESHOLD=0.80

# Urgency >= this → prefer market order regardless of confidence.
EXEC_TAKER_URGENCY_THRESHOLD=0.90

# Bid-ask spread <= this → prefer limit (maker) order even at high confidence.
EXEC_TAKER_SPREAD_THRESHOLD=0.005

# Cancel unmatched limit orders after this many seconds.
EXEC_ORDER_TIMEOUT_SECS=120


# -----------------------------------------------------------------------------
# 7d. Param Profiles & Kill-Switch  (QUANT_MODE_ENABLED=1 required)
# -----------------------------------------------------------------------------

# Active parameter profile: "conservative" | "balanced" | "aggressive" | "auto"
# "auto" selects by detected market regime:
#   unknown   → conservative  (conf=0.55, edge=0.018)
#   ranging   → balanced      (conf=0.42, edge=0.012)
#   trending  → aggressive    (conf=0.32, edge=0.008)
PARAM_PROFILE=auto

# Kill-switch — API error rate triggers (fraction of calls in last 60 s).
# Tier 1 = warn, Tier 2 = 50 % size reduction, Tier 3 = block new entries.
KS_TIER1_API_ERROR_RATE=0.20
KS_TIER2_API_ERROR_RATE=0.40
KS_TIER3_API_ERROR_RATE=0.60

# Kill-switch — price-feed staleness triggers (seconds since last valid price).
KS_TIER1_STALE_SECS=30.0
KS_TIER2_STALE_SECS=90.0
KS_TIER3_STALE_SECS=300.0

# Kill-switch — drawdown pace triggers (fraction of daily limit lost per hour).
KS_TIER1_DD_PACE_PCT=0.20
KS_TIER2_DD_PACE_PCT=0.50
KS_TIER3_DD_PACE_PCT=0.80
